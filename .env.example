# Register these callback URLs with your OAuth providers after deployment:
# GitHub: https://<your-service>.onrender.com/api/auth/github/callback
# Google: https://<your-service>.onrender.com/api/auth/google/callback
# Set APP_URL to the deployed service URL when using a custom domain or when
# the app cannot infer its public URL from the forwarded request headers.
APP_URL=https://<your-service>.onrender.com

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-side AI key. Leave unset to have users provide their own key.
GEMINI_API_KEY=
